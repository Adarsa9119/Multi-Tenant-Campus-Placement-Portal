NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campus_placement
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173

# OTP (email second factor for every role)
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_PEPPER=replace-with-a-separate-long-random-secret

# SMTP is required for OTP and other email delivery in every environment.
# Use credentials and a sender address accepted by your SMTP provider.
# SMTP_USERNAME/SMTP_PASSWORD are also accepted as aliases for SMTP_USER/SMTP_PASS.
# Use port 465 with SMTP_SECURE=true for implicit TLS, or port 587 with false for STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Campus Placement Portal <no-reply@example.com>"

# Protected file storage (outside any public/static folder)
UPLOAD_DIR=./uploads
MAX_RESUME_MB=5

# Initial Super Admin (created by `npm run seed`; no public signup exists)
SEED_SUPER_ADMIN_NAME=Platform Admin
SEED_SUPER_ADMIN_EMAIL=padhuncmrwf@gmail.com
SEED_DEMO_PASSWORD=Demo@12345
